<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>codeshield</AssemblyName>
    <RootNamespace>CodeShield.Mcp</RootNamespace>
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Framework-dependent, architecture-neutral .NET tool, installed with: dotnet tool install CodeShield.Tool (global) -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>codeshield</ToolCommandName>
    <PackageId>CodeShield.Tool</PackageId>
    <Description>Deterministic code-quality evaluator for AI coding agents, exposed as a local MCP server for C#, TypeScript and Kotlin changes.</Description>
    <PackageTags>mcp;code-quality;roslyn;typescript;kotlin;detekt;agents</PackageTags>
    <Authors>BerserkerDotNet</Authors>
    <Copyright>Copyright (c) 2026 BerserkerDotNet</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/BerserkerDotNet/CodeShield</PackageProjectUrl>
    <RepositoryUrl>https://github.com/BerserkerDotNet/CodeShield.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Dependency dotfiles (.npmignore and similar) are part of the locked tree and must not be silently dropped. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\'))</RepoRoot>
    <PayloadDirectory>$(RepoRoot)artifacts\payload\</PayloadDirectory>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeShield.Core\CodeShield.Core.csproj" />
    <ProjectReference Include="..\CodeShield.Git\CodeShield.Git.csproj" />
    <ProjectReference Include="..\CodeShield.TypeScript\CodeShield.TypeScript.csproj" />
    <ProjectReference Include="..\CodeShield.CSharp\CodeShield.CSharp.csproj" />
    <ProjectReference Include="..\CodeShield.Kotlin\CodeShield.Kotlin.csproj" />
  </ItemGroup>

  <!--
    The single producer-side payload pipeline shared by scripts/setup.* (portable directory) and dotnet pack (tool package).
    It builds the TypeScript worker, stages it with its locked production dependencies, builds the Kotlin worker jar with the
    Gradle wrapper (a JDK 17+ is a producer prerequisite, like npm), and adds the schemas, release manifest and agent guidance next
    to the host. npm and Gradle run only here; they never run on a user's machine. Any failure fails publish and pack.
  -->
  <Target Name="PreparePayload" BeforeTargets="ComputeResolvedFilesToPublishList">
    <PropertyGroup>
      <WorkerSource>$(RepoRoot)worker\</WorkerSource>
      <WorkerStage>$(PayloadDirectory)worker\</WorkerStage>
      <KotlinWorkerSource>$(RepoRoot)kotlin-worker\</KotlinWorkerSource>
      <KotlinWorkerJar>$(KotlinWorkerSource)dist\codeshield-kotlin-worker.jar</KotlinWorkerJar>
    </PropertyGroup>

    <Exec Command="npm ci" WorkingDirectory="$(WorkerSource)" />
    <Exec Command="npm run build" WorkingDirectory="$(WorkerSource)" />
    <Error Condition="!Exists('$(WorkerSource)dist\main.js')" Text="The TypeScript worker build did not produce worker\dist\main.js." />

    <Exec Condition="'$(OS)' == 'Windows_NT'" Command="gradlew.bat jar --no-daemon --quiet" WorkingDirectory="$(KotlinWorkerSource)" />
    <Exec Condition="'$(OS)' != 'Windows_NT'" Command="sh ./gradlew jar --no-daemon --quiet" WorkingDirectory="$(KotlinWorkerSource)" />
    <Error Condition="!Exists('$(KotlinWorkerJar)')" Text="The Kotlin worker build did not produce kotlin-worker\dist\codeshield-kotlin-worker.jar." />

    <RemoveDir Directories="$(PayloadDirectory)" />
    <ItemGroup>
      <WorkerDist Include="$(WorkerSource)dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkerDist)" DestinationFiles="@(WorkerDist->'$(WorkerStage)dist\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(WorkerSource)package.json;$(WorkerSource)package-lock.json" DestinationFolder="$(WorkerStage)" />
    <Exec Command="npm ci --omit=dev" WorkingDirectory="$(WorkerStage)" />
    <Error Condition="!Exists('$(WorkerStage)node_modules\eslint\package.json')" Text="Locked production dependencies were not installed into the worker payload." />

    <ItemGroup>
      <PayloadWorker Include="$(WorkerStage)**\*" Exclude="$(WorkerStage)node_modules\.bin\**" />
      <PayloadSchemas Include="$(RepoRoot)docs\schemas\**\*" />
      <PayloadGuidance Include="$(RepoRoot)docs\agent-instructions\**\*" />
      <ResolvedFileToPublish Include="@(PayloadWorker)" RelativePath="worker\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(KotlinWorkerJar)" RelativePath="kotlin-worker\dist\codeshield-kotlin-worker.jar" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="@(PayloadSchemas)" RelativePath="schemas\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="@(PayloadGuidance)" RelativePath="agent-instructions\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(RepoRoot)docs\release-manifest.json" RelativePath="release-manifest.json" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(RepoRoot)LICENSE" RelativePath="LICENSE" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(RepoRoot)THIRD-PARTY-NOTICES.md" RelativePath="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(RepoRoot)licenses\Apache-2.0.txt" RelativePath="licenses\Apache-2.0.txt" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!--
    Upstream attribution notices of every redistributed NuGet package (found through the publish list's package metadata, so the
    notice set always matches the assemblies actually shipped) are staged next to them under licenses\.
  -->
  <Target Name="StagePackageNotices" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_ShippedPackageId Include="@(ResolvedFileToPublish->'%(NuGetPackageId)|%(NuGetPackageVersion)')" Condition="'%(ResolvedFileToPublish.NuGetPackageId)' != ''" />
    </ItemGroup>
    <ItemGroup>
      <_PackageIdentity Include="@(_ShippedPackageId->Distinct())">
        <Id>$([System.String]::Copy('%(Identity)').Split('|')[0])</Id>
        <Version>$([System.String]::Copy('%(Identity)').Split('|')[1])</Version>
      </_PackageIdentity>
      <!-- Every top-level file is listed and filtered by a case-insensitive regex, so LICENSE, license.txt and THIRD-PARTY-NOTICES.TXT match on case-sensitive file systems too. -->
      <_PackageFile Include="$(NuGetPackageRoot)$([System.String]::Copy('%(_PackageIdentity.Id)').ToLowerInvariant())\%(_PackageIdentity.Version)\*">
        <NoticeOwner>%(_PackageIdentity.Id)</NoticeOwner>
      </_PackageFile>
      <_PackageNotice Include="@(_PackageFile)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_PackageFile.Filename)%(_PackageFile.Extension)', '(?i)notice|licen[sc]e|copying'))" />
      <ResolvedFileToPublish Include="@(_PackageNotice)" RelativePath="licenses\%(_PackageNotice.NoticeOwner)\%(_PackageNotice.Filename)%(_PackageNotice.Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
