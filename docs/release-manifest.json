      "id": "complexity.cyclomatic",
      "category": "complexity",
      "limit": 6,
      "deduction": 12,
      "calculation": "1 base \u002B counted decisions"
    },
    {
      "id": "complexity.nesting",
      "category": "complexity",
      "limit": 2,
      "deduction": 11,
      "calculation": "maximum nesting depth"
    },
    {
      "id": "complexity.method-length",
      "category": "complexity",
      "limit": 40,
      "deduction": 11,
      "calculation": "code lines"
    },
    {
      "id": "cohesion.lcom4",
