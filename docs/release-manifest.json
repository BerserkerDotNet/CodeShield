      "limit": 0,
      "deduction": 15,
      "calculation": "new forbidden edges"
    },
    {
      "id": "coupling.main-sequence-distance",
      "category": "coupling",
      "limit": 0.5,
      "deduction": 12,
      "calculation": "D \u003E 0.5 and (new module or D increased by at least 0.1)"
    },
    {
      "id": "structure.file-length",
